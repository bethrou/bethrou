# Binary — anchored to repo root so it doesn't also match the
# cmd/bethrou/ directory (an unanchored pattern here previously matched
# and silently excluded that whole directory, including main.go, from
# git — it was never actually committed as a result).
/bethrou

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
tmp/

# Keys
network.key
client.key
client.key*

# Environment files (local secrets) — never commit these.
.env
.env.local
.env.*.local
